<?xml version="1.0" encoding="UTF-8"?>

<routes>

    <!-- Normal road vehicles -->
    <vType
        id="car"
        accel="2.6"
        decel="4.5"
        sigma="0.5"
        length="5"
        minGap="2.5"
        maxSpeed="13.9"
    />

    <!-- Emergency ambulance -->
    <vType
        id="ambulance"
        accel="3.0"
        decel="5.0"
        sigma="0.2"
        length="6"
        minGap="2.5"
        maxSpeed="20.0"
        color="1,0,0"
    />

    <!-- Vehicle used to create the accident blockage -->
    <vType
        id="accidentVehicle"
        accel="2.6"
        decel="4.5"
        sigma="0.5"
        length="5"
        minGap="2.5"
        maxSpeed="13.9"
        color="0,0,0"
    />


    <!-- ========================================================= -->
    <!-- NORMAL ROUTES                                               -->
    <!-- ========================================================= -->

    <route id="normalRoute1" edges="E1 E3"/>
    <route id="normalRoute2" edges="E13 E5"/>
    <route id="normalRoute3" edges="E17 E19"/>
    <route id="normalRoute4" edges="E21 E23"/>
    <route id="normalRoute5" edges="E14 E1"/>
    <route id="normalRoute6" edges="E18 E2"/>
    <route id="normalRoute7" edges="E20 E6"/>
    <route id="normalRoute8" edges="E24 E8"/>
    <route id="normalRoute9" edges="E15 E9"/>


    <!-- ========================================================= -->
    <!-- ACCIDENT ROUTE                                              -->
    <!-- ========================================================= -->

    <route
        id="accidentRoute"
        edges="E3"
    />


    <!-- ========================================================= -->
    <!-- NORMAL TRAFFIC FLOWS                                        -->
    <!-- ========================================================= -->

    <flow
        id="traffic1"
        type="car"
        route="normalRoute1"
        begin="0"
        end="1800"
        vehsPerHour="300"
    />

    <flow
        id="traffic2"
        type="car"
        route="normalRoute4"
        begin="0"
        end="1800"
        vehsPerHour="300"
    />

    <flow
        id="traffic3"
        type="car"
        route="normalRoute5"
        begin="0"
        end="1800"
        vehsPerHour="250"
    />

    <flow
        id="traffic4"
        type="car"
        route="normalRoute7"
        begin="0"
        end="1800"
        vehsPerHour="250"
    />


    <!-- ========================================================= -->
    <!-- CITYBRAIN AMBULANCE                                        -->
    <!-- ========================================================= -->

    <!--
        The ambulance becomes available when the accident occurs.
        CityBrain will detect it through TraCI.
    -->

    <vehicle
        id="ambulance0"
        type="ambulance"
        route="normalRoute1"
        depart="300"
        departSpeed="max"
    />


    <!-- ========================================================= -->
    <!-- ACCIDENT BLOCKER                                           -->
    <!-- ========================================================= -->

    <!--
        This vehicle physically blocks E3.
        It stops at position 40 and remains there for 1500 seconds.
    -->

    <vehicle
        id="accident_blocker"
        type="accidentVehicle"
        route="accidentRoute"
        depart="300"
        departPos="40"
        departSpeed="0"
    >
        <stop
            lane="E3_0"
            endPos="50"
            duration="1500"
        />
    </vehicle>

</routes>
